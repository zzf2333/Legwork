{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BossAssistantMatchBatch",
  "description": "宿主 agent 对一个批次岗位的匹配结果。必须覆盖批次全部岗位。",
  "type": "object",
  "additionalProperties": false,
  "required": ["packet_id", "results"],
  "properties": {
    "packet_id": {
      "type": "string",
      "description": "与批次文件中的 packet_id 一致"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/result" }
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "action", "reason", "conditions", "greeting", "resume_fact_ids"],
      "properties": {
        "job_id": { "type": "string" },
        "action": { "enum": ["send", "skip"] },
        "reason": { "type": "string", "minLength": 1 },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/condition" }
        },
        "greeting": {
          "type": "string",
          "description": "action=send 时为定制招呼正文；action=skip 时必须是空字符串"
        },
        "resume_fact_ids": {
          "type": "array",
          "description": "action=send 时引用 resume_facts 的 ID；action=skip 时必须是空数组",
          "items": { "type": "string" }
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidence"],
      "properties": {
        "id": { "type": "string" },
        "status": { "enum": ["met", "unmet", "unknown"] },
        "evidence": { "type": "string" }
      }
    }
  }
}
